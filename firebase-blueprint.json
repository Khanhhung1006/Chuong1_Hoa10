{
  "entities": {
    "classes": {
      "title": "Class Data",
      "description": "Information and state of the managed class",
      "type": "object",
      "properties": {
        "className": { "type": "string" },
        "schoolName": { "type": "string" },
        "teacherName": { "type": "string" },
        "lastUpdated": { "type": "string" }
      }
    },
    "students": {
      "title": "Student",
      "description": "Student profiles in the class",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "fullName": { "type": "string" },
        "gender": { "type": "string" },
        "dob": { "type": "string" },
        "group": { "type": "number" },
        "parentPhone": { "type": "string" }
      },
      "required": ["id", "fullName", "code"]
    },
    "attendance": {
      "title": "Attendance Record",
      "description": "Daily attendance logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "studentId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "date", "studentId", "status"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
